---MOVE

local function FlyTo(cf)
RefreshChar()
local dist = (hrp.Position - cf.Position).Magnitude
local tween = TweenService:Create(
hrp,
TweenInfo.new(math.clamp(dist/200,0.2,40), Enum.EasingStyle.Linear),
{CFrame = cf}
)
tween:Play()
tween.Completed:Wait()
end

