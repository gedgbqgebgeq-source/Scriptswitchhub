---MOB

function GetNearestMob()
local nearest, dist = nil, math.huge
for _,v in pairs(workspace.Enemies:GetChildren()) do
if v.Name == MON and v:FindFirstChild("HumanoidRootPart")
and v.Humanoid.Health > 0 then
local d = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
if d < dist then
dist = d
nearest = v
end
end
end
return nearest
end

-- ล็อกมอนตัวหลัก
local function LockMob(mob)
    local hrp = mob.HumanoidRootPart
    local hum = mob.Humanoid

    hrp.Anchored = true
    hrp.CanCollide = false
    hrp.Size = Vector3.new(60,60,60)
    hrp.Transparency = 1

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.AutoRotate = false
end

-- ซ้อนมอน
local function StackMobs(mainMob)
    local mainHRP = mainMob.HumanoidRootPart

    for _,v in pairs(workspace.Enemies:GetChildren()) do
        if v ~= mainMob
        and v.Name == MON
        and v:FindFirstChild("HumanoidRootPart")
        and v.Humanoid.Health > 0 then

            local hrp2 = v.HumanoidRootPart
            local hum2 = v.Humanoid

            if (hrp2.Position - mainHRP.Position).Magnitude <= 200 then
                hrp2.CFrame = mainHRP.CFrame
                hrp2.Anchored = true
                hrp2.CanCollide = false
                hum2.WalkSpeed = 0
                hum2.JumpPower = 0
            end
        end
    end
end
local RunService = game:GetService("RunService")

local function HoverAboveMob(mob)
    RunService.Heartbeat:Connect(function()
        if not _G.AutoFarm then return end
        if not mob or not mob:FindFirstChild("HumanoidRootPart") then return end
        if mob.Humanoid.Health <= 0 then return end

        hrp.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0,40,0)
        hrp.Velocity = Vector3.zero
    end)
end

