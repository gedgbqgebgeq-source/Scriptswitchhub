---MONSTER STUCK FIX (HIT FIRST → 4s NO DMG → KILL)

local lastHealth = 0
local lastDamageTime = 0
local hasAttacked = false

task.spawn(function()
    while task.wait(0.2) do
        if _G.AutoFarm and currentMob
        and currentMob:FindFirstChild("Humanoid")
        and currentMob:FindFirstChild("HumanoidRootPart") then

            local hum = currentMob.Humanoid
            local mobHRP = currentMob.HumanoidRootPart

            -- เริ่มตีจริง (เลือดลดครั้งแรก)
            if hum.Health < lastHealth then
                hasAttacked = true
                lastDamageTime = tick()
                lastHealth = hum.Health
            end

            -- เซ็ตค่าเริ่มต้น
            if lastHealth == 0 then
                lastHealth = hum.Health
            end

            -- ตีแล้ว แต่เลือดไม่ลดเกิน 4 วิ
            if hasAttacked
            and hum.Health > 0
            and (tick() - lastDamageTime) >= 4 then

                warn("⚠️ MON BUG | HIT BUT NO DAMAGE → FORCE KILL")

                -- ดึงมอนมาหาตัวผู้เล่น
                mobHRP.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)

                task.wait(0.1)

                -- Kill มอนชนิดเดียวกันใกล้ตัว
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:IsA("Model")
                    and v.Name == currentMob.Name
                    and v:FindFirstChild("Humanoid")
                    and v.Humanoid.Health > 0 then
                        v.Humanoid.Health = 0
                    end
                end

                -- รีเซ็ตสถานะ
                hasAttacked = false
                lastHealth = 0
                lastDamageTime = 0
                currentMob = nil
            end
        else
            -- หลุดเป้า รีเซ็ต
            hasAttacked = false
            lastHealth = 0
            lastDamageTime = 0
        end
    end
end)
